# ─────────────────────────────────────────────────────────────────────────────
# EEG Research Copilot — Environment Configuration
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Deployment environment: development | staging | production
ENVIRONMENT=development
# Enable FastAPI debug mode (must be False in production)
DEBUG=false

# ── OpenAI ────────────────────────────────────────────────────────────────────
# REQUIRED: your OpenAI API key (sk-...)
OPENAI_API_KEY=

# Generation model (gpt-4o recommended for citation accuracy)
OPENAI_MODEL=gpt-4o

# Sampling temperature: low = deterministic citations, high = creative
OPENAI_TEMPERATURE=0.1

# Maximum completion tokens per generation call
OPENAI_MAX_TOKENS=2048

# HTTP timeout (seconds) for OpenAI API requests
OPENAI_REQUEST_TIMEOUT=60.0

# ── Embedding Model ───────────────────────────────────────────────────────────
# HuggingFace model ID for sentence-transformers (downloaded on first run)
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5

# Torch compute device: cpu | cuda | cuda:0 | mps (Apple Silicon)
EMBEDDING_DEVICE=cpu

# Batch size for embedding inference (increase for GPU)
EMBEDDING_BATCH_SIZE=32

# L2-normalise embeddings before storing (required for cosine similarity)
EMBEDDING_NORMALIZE_EMBEDDINGS=true

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Directory for ChromaDB persistence (DuckDB + Parquet files)
CHROMA_PERSIST_DIR=data/chroma_db

# ChromaDB collection name for EEG paper chunks
CHROMA_COLLECTION_NAME=eeg_papers

# HNSW distance metric: cosine | l2 | ip
CHROMA_DISTANCE_FUNCTION=cosine

# Extra candidates fetched to absorb metadata-filtered exclusions
CHROMA_N_RESULTS_BUFFER=5

# ── BM25 Index ────────────────────────────────────────────────────────────────
# Path to the serialised BM25Okapi corpus (.pkl)
BM25_INDEX_PATH=data/bm25_index.pkl

# BM25 term-frequency saturation parameter (k1)
BM25_K1=1.5

# BM25 document-length normalisation parameter (b)
BM25_B=0.75

# BM25Plus lower-bound epsilon for IDF
BM25_EPSILON=0.25

# ── PDF Ingestion ─────────────────────────────────────────────────────────────
# Directory scanned for raw EEG PDF papers
INGESTION_PDF_DIR=data/pdfs

# Maximum token budget per DocumentChunk (sliding window size)
INGESTION_MAX_CHUNK_TOKENS=512

# Token overlap between consecutive chunks
INGESTION_CHUNK_OVERLAP_TOKENS=64

# Discard chunks shorter than this character count (noise filter)
INGESTION_MIN_CHUNK_CHARS=80

# ── API Server ────────────────────────────────────────────────────────────────
# Uvicorn bind host
API_HOST=0.0.0.0

# Uvicorn bind port
API_PORT=8000

# Number of worker processes (set to CPU count in production)
API_WORKERS=1

# Allowed CORS origins (comma-separated; use specific origins in production)
# Example: API_CORS_ORIGINS=["https://myapp.com","https://staging.myapp.com"]
API_CORS_ORIGINS=["*"]

# HTTP header name for request trace ID propagation
API_REQUEST_ID_HEADER=X-Request-ID

# Maximum ingest request body size in MB
API_MAX_REQUEST_BODY_MB=50.0

# ── Logging ───────────────────────────────────────────────────────────────────
# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Emit structured JSON logs (true) or human-readable dev logs (false)
LOG_JSON_LOGS=false

# Include full LLM prompt text in logs (NEVER true in production — PII risk)
LOG_LOG_LLM_PROMPTS=false
